        "jsCode": "const b=$json.body;\nif (!b || !Array.isArray(b.cfg_turnos) || !Array.isArray(b.cfg_tabelas_extras) || !Array.isArray(b.cfg_fiscais_padrao) || !Array.isArray(b.cfg_excecoes_padrao)) throw new Error('Configuração inválida.');\nconst ids=new Set();\nfor (const item of [...b.cfg_turnos,...b.cfg_tabelas_extras]) {\n    if (!/^(t|tbl)_[a-zA-Z0-9_-]+$/.test(item.id || '') || ids.has(item.id)) throw new Error('Identificador inválido ou repetido.');\n    ids.add(item.id);\n}\nfor (const table of b.cfg_tabelas_extras) if (!Array.isArray(table.colunas) || !table.colunas.length || table.colunas.some(c=>typeof c!=='string')) throw new Error('Colunas inválidas.');\nif (!Number.isInteger(b.max_folgantes) || b.max_folgantes < 0) throw new Error('Limite inválido.');\nfor (const key of ['cor_primaria','cor_secundaria','cor_alerta']) if (!/^#[0-9a-f]{6}$/i.test(b[key] || '')) throw new Error('Cor inválida.');\nreturn [{json:$json}];"

          "queryReplacement": "={{ [$json.body.data_escala,\n    $json.body.json_turnos.t_06 || '', $json.body.json_turnos.t_08 || '',\n    $json.body.json_turnos.t_11 || '', $json.body.json_turnos.t_12 || '',\n    $json.body.fiscais || '', $json.body.folgas || '', $json.body.observacoes || '',\n    $json.body.json_excecoes_horario || '[]', $json.body.json_tabelas_extras || '{}',\n    JSON.stringify($json.body.json_turnos), JSON.stringify($json.body.json_layout),\n    $json.body.save_request_id, $json.body.expected_updated_at || null] }}"

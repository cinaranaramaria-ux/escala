    {
      "parameters": {
        "jsCode": "const body = $json.body;\nif (!body || typeof body !== 'object') throw new Error('Dados da escala ausentes.');\nconst validDate = value => /^\\d{4}-\\d{2}-\\d{2}$/.test(value || '') &&\n    !Number.isNaN(Date.parse(value)) && new Date(value).toISOString().slice(0,10) === value;\nif (!validDate(body.data_escala)) throw new Error('Data inválida.');\nif (!body.save_request_id || !/^[\\w-]{8,100}$/.test(body.save_request_id)) throw new Error('Identificador do envio inválido.');\nif (!body.json_turnos || Array.isArray(body.json_turnos) || typeof body.json_turnos !== 'object') throw new Error('Turnos ausentes.');\nif (!body.json_layout || !Array.isArray(body.json_layout.turnos) || !Array.isArray(body.json_layout.tabelas)) throw new Error('Layout ausente.');\nconst parse = (value, fallback) => typeof value === 'string' ? JSON.parse(value) : value || fallback;\nconst normalize = n => String(n).normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').trim().toLowerCase();\nconst allocated = new Set();\nconst add = value => {\n    String(value || '').split(',').filter(n=>n.trim()).forEach(n=> {\n        const key=normalize(n); if (allocated.has(key)) throw new Error('Colaborador duplicado: '+n);\n        allocated.add(key);\n    });\n};\nfor (const [id,names] of Object.entries(body.json_turnos)) {\n    if (!/^t_[a-zA-Z0-9_-]+$/.test(id) || typeof names !== 'string') throw new Error('Turno inválido.');\n    add(names);\n}\nadd(body.folgas);\nString(body.fiscais || '').split('||').filter(Boolean).forEach(row => add(row.split('|')[0]));\nconst extra = parse(body.json_tabelas_extras, {});\nfor (const table of body.json_layout.tabelas) {\n    if (!/^tbl_[a-zA-Z0-9_-]+$/.test(table.id) || !Array.isArray(table.colunas) || !table.colunas.length) throw new Error('Tabela inválida.');\n    if (!Array.isArray(extra[table.id] || [])) throw new Error('Linhas inválidas.');\n    for (const row of extra[table.id] || []) add(row[table.colunas[0]]);\n}\nfor (const turno of body.json_layout.turnos) {\n    if (!/^t_[a-zA-Z0-9_-]+$/.test(turno.id)) throw new Error('ID de turno inválido.');\n}\nif (body.expected_updated_at && Number.isNaN(Date.parse(body.expected_updated_at))) throw new Error('Versão base inválida.');\nconst exceptions = parse(body.json_excecoes_horario, []);\nif (!Array.isArray(exceptions)) throw new Error('Exceções inválidas.');\nreturn [{json: {...$json, body: {...body,\n    json_excecoes_horario:JSON.stringify(exceptions), json_tabelas_extras:JSON.stringify(extra)}}}];"
      },
